# Server only. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional comma-separated credentials for one Google project/quota group.
# Rotate across healthy credentials; HTTP 429 stops the whole pool for 60 seconds.
GEMINI_API_KEYS=
# Use developer for Gemini API; vertex for explicitly configured Vertex Express.
GEMINI_BACKEND=developer
GEMINI_MODEL=gemini-3.5-flash
# Required to enable AI in production (atomic shared cooldown, budget and cache).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_DAILY_REQUEST_LIMIT=500
AI_HOURLY_REQUEST_LIMIT=120
